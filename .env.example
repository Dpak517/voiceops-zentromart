# Copy this file to .env and fill in your keys. NEVER commit .env
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# optional: a cheaper model just for the query-rewrite step
GROQ_REWRITE_MODEL=
GNANI_API_KEY=
# speech settings (defaults shown)
GNANI_STT_LANG=en-IN
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri
